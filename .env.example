# Copy to .env for local development: cp .env.example .env
# .env is gitignored. Never commit real credentials.
# In production these are set in the Render dashboard, not from a file.

# --- Spotify (powers /api/spotify-token, album artwork) ---
# Spotify Developer Dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Mailchimp (powers /api/newsletter) ---
# API key format: <32 hex chars>-<datacenter>, e.g. abc123...-us13
# Audience ID is a short 10-char id (Audience -> Settings -> Audience name and defaults)
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# --- Mailgun (powers contact form email notifications) ---
# MAILGUN_DOMAIN must be a verified sending domain in your Mailgun account.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=drakkariblack.com
# EU-region accounts only: https://api.eu.mailgun.net
# MAILGUN_API_URL=
# Optional overrides (defaults: info@drakkariblack.com / website@$MAILGUN_DOMAIN)
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=

# --- Session secret ---
# Not currently read by any code. express-session/passport are installed but
# unused. Present for when auth is wired up.
SESSION_SECRET=
